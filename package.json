{
  "name": "nermai_ias_academy",
  "version": "1.0.0",
  "description": "Integrated NERMAI IAS Academy Platform",
  "main": "index.ts",
  "scripts": {
    "dev": "concurrently \"npm run web\" \"cd backend && npm run start\"",
    "start": "cd web_portal && npx expo start --web",
    "web": "cd web_portal && npx expo start --web",
    "build:web": "npm --prefix web_portal run build && node -e \"require('fs').cpSync('web_portal/dist', 'dist', {recursive: true})\"",
    "deploy": "npm run build:web && npx firebase deploy",
    "android": "cd web_portal && npx expo start --android",
    "ios": "cd web_portal && npx expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "^57.0.24",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-print": "~57.0.2",
    "expo-screen-capture": "~57.0.3",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
